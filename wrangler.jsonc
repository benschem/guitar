{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "guitar",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-24",
  // Everything in public/ is served as a static file, before the Worker
  // runs. _headers in there sets the security and no-indexing headers on
  // those files.
  "assets": {
    "directory": "./public/",
  },
  // The ticks table. Its schema is in migrations/.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "guitar",
      "database_id": "a2d01d9c-08ad-4b7e-8c01-5d9600e1bba0",
    },
  ],
}
